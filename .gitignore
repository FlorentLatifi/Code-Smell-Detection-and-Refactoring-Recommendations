# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Node
node_modules/
dist/

# Data & artifacts
data/raw/
data/corpus/
# Trained models and their manifests. Regenerated from the committed feature
# table in seconds, and a pickled estimator is undefined across scikit-learn
# versions anyway, so the repository carries the recipe rather than the result.
data/models/
# The diff bundle read during the rewrite review. Regenerated by
# review_rewrites.py --sample; the judgements it produced are committed, the
# megabytes of diff they were read from are not.
data/review/
# PMD, shkarkuar nga fetch_pmd.py per krahasimin me nje mjet te jashtem.
# 127 MB binar i palidhur me kodin tone; recepta komitohet, artefakti jo.
data/tools/
*.joblib
*.pkl
.env

# Transient state of an interrupted build_dataset run. data/results/ is
# committed, so these have to be excluded by name or a crashed run leaves them
# staged for the next commit.
data/results/*.part
data/results/*progress.json
data/results/*.progress.json

# OS
Thumbs.db
.DS_Store

# Tooling caches
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
data/*.log
data/*.err
data/*.pid

# Frontend build output
frontend/dist/
frontend/*.tsbuildinfo
