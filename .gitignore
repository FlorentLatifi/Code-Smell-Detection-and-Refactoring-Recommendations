# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Node
node_modules/
dist/

# Data & artifacts
data/raw/
data/corpus/
# Trained models and their manifests. Regenerated from the committed feature
# table in seconds, and a pickled estimator is undefined across scikit-learn
# versions anyway, so the repository carries the recipe rather than the result.
data/models/
*.joblib
*.pkl
.env

# Transient state of an interrupted build_dataset run. data/results/ is
# committed, so these have to be excluded by name or a crashed run leaves them
# staged for the next commit.
data/results/*.part
data/results/*.progress.json

# OS
Thumbs.db
.DS_Store

# Tooling caches
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
data/*.log
